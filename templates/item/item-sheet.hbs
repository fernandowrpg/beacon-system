<div class="item-sheet item-{{item.type}}">
  <header class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" data-action="editImage" alt="">
    <div class="item-title">
      <input class="item-name" type="text" name="name" value="{{item.name}}">
      <span class="item-type">{{localize (concat "TYPES.Item." item.type)}}</span>
    </div>
  </header>
  <div class="item-body">
    {{> (lookup this "bodyPartial")}}
  </div>
</div>
